<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.PCC" parent="Theme.AppCompat.Light.NoActionBar">
        <item name="android:fontFamily">sans</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:statusBarColor">#073F36</item>
        <item name="android:navigationBarColor">#F8F6F0</item>
        <item name="android:windowBackground">#F8F6F0</item>
        <item name="android:windowActionModeOverlay">true</item>
    </style>

    <style name="Theme.PCC.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">#F8F6F0</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/pcc_icon</item>
        <item name="postSplashScreenTheme">@style/Theme.PCC</item>
    </style>
</resources>
