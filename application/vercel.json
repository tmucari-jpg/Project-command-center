{
  "framework": "nextjs",
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=()"
        }
      ]
    }
  ],
  "git": {
    "deploymentEnabled": {
      "audit/consolidated-diagnostic-20261022": false,
      "audit/commercial-master-20261022": false,
      "audit/pcc-final-consolidation-20261023": false,
      "audit/adaptive-factory-ai-router-20261024": false,
