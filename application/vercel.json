{
  "framework": "nextjs",
  "headers": [
    {
      "source": "/client-diagnostic/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store, max-age=0"
        },
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow, noarchive"
        },
        {
          "key": "Referrer-Policy",
          "value": "no-referrer"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Cross-Origin-Opener-Policy",
          "value": "same-origin"
        },
        {
          "key": "Content-Security-Policy",
          "value": "frame-ancestors 'none'; base-uri 'none'; object-src 'none'; form-action 'self'"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=()"
        }
      ]
    }
  ],
  "git": {
    "deploymentEnabled": {
      "audit/consolidated-diagnostic-20261022": false,
      "audit/commercial-master-20261022": false,
      "audit/pcc-final-consolidation-20261023": false,
      "audit/adaptive-factory-ai-router-20261024": false,
      "audit/investment-discovery-decision-20261024": false,
      "audit/investment-capabilities-options-20261024": false,
      "audit/investment-intake-multiselect-diagnostic-20261024": false,
      "audit/client-diagnostic-questionnaire-20261024": false,
      "audit/client-diagnostic-short-v2-20261024": false,
      "audit/client-diagnostic-executive-v3-20261024": false,
      "audit/new-project-questionnaire-actions-ui-20261024": false
    }
  }
}
