NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# AI providers
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6-luna
QWEN_API_KEY=
QWEN_MODEL=qwen-plus
# Qwen Cloud Workspace/Region endpoint is stored in the provider profile in PCC Administration.

# Free-only policy. Paid accounts are retained for compatibility but never selected.
# Keep false unless this key belongs to a verified Groq free-tier account, with no paid upgrade.
PCC_GROQ_FREE_TIER=false
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
# Enable generation only in an isolated test deployment until validation.
PCC_ARTIFACT_GENERATION_ENABLED=false
