<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.GIE360" parent="Theme.AppCompat.Light.NoActionBar">
        <item name="android:fontFamily">sans</item>
        <item name="android:statusBarColor">#073F36</item>
        <item name="android:navigationBarColor">#F8F6F0</item>
        <item name="android:windowBackground">#F8F6F0</item>
